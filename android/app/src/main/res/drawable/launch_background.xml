<?xml version="1.0" encoding="utf-8"?>
<!-- Splash native: gradien biru logo + ikon aplikasi di tengah. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#0254A6"
                android:endColor="#031D61"/>
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
